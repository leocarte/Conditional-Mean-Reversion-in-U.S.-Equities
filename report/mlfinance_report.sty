\newlength\titlebox
\setlength\titlebox{1.75in}

\def\maketitle{\par
  \begingroup
  \twocolumn[\@maketitle] \@thanks
  \endgroup
  \let\maketitle\relax
  \let\@maketitle\relax
  \gdef\@thanks{}
  \gdef\@author{}
  \gdef\@title{}
  \let\thanks\relax
}

\def\@maketitle{%
  \setbox\@tempboxa=\vbox{%
    \linewidth\hsize
    \centering
    {\LARGE\bfseries \@title \par}%
    \vskip 0.9em%
    \@author
    \vskip 14pt\relax%
  }%
  \ifdim\ht\@tempboxa<\titlebox
    \vbox to\titlebox{\unvbox\@tempboxa\vfill}%
  \else
    \box\@tempboxa
  \fi
}

\renewenvironment{abstract}
{
  \centerline{\normalsize\bfseries Abstract}
  \vskip 0.75em
  \begin{list}{}{%
      \setlength{\leftmargin}{0.15in}%
      \setlength{\rightmargin}{0.15in}%
      \setlength{\topsep}{0pt}%
      \setlength{\partopsep}{0pt}%
      \setlength{\itemsep}{0pt}%
      \setlength{\parsep}{8pt}%
    }\item\relax
      \small
}
{\par\end{list}}

